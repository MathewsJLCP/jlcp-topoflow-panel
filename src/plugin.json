      { "name": "Mapa de rede no tema escuro", "path": "img/screenshots/mapa-escuro.png" },
      { "name": "Mapa de rede no tema claro", "path": "img/screenshots/mapa-claro.png" },
      { "name": "Gráfico das métricas no hover", "path": "img/screenshots/hover-grafico.png" },
      { "name": "Editor de elementos no painel de opções", "path": "img/screenshots/editor.png" }
    ],
    "version": "%VERSION%",
